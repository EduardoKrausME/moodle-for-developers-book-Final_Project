{{!
    @template mod_checkpoint/student_status

    Example context (json):
    {
        "name": "Final project checkpoint",
        "status": "Submitted",
        "late": true,
        "can_edit": true,
        "editurl": "https://example.com/mod/checkpoint/submission.php?id=42",
        "hastext": true,
        "submissiontext": "<p>The first version of the project has been completed.</p>",
        "hasfiles": true,
        "files": [
            {
                "name": "project-report.pdf",
                "url": "https://example.com/pluginfile.php/123/mod_checkpoint/evidence/456/project-report.pdf"
            },
            {
                "name": "source-code.zip",
                "url": "https://example.com/pluginfile.php/123/mod_checkpoint/evidence/456/source-code.zip"
            }
        ],
        "graded": true,
        "grade": "85.00",
        "grademax": "100.00",
        "hasfeedback": true,
        "feedback": "<p>Good work. Review the documentation before the final submission.</p>"
    }
}}
<div class="mod-checkpoint-status card mb-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-3">
            <div>
                <h3 class="h5 mb-2">{{name}}</h3>
                <div class="mb-2">
                    <span class="badge text-bg-secondary">{{status}}</span>
                    {{#late}}<span class="badge text-bg-warning">{{#str}}late, mod_checkpoint{{/str}}</span>{{/late}}
                </div>
            </div>
            {{#can_edit}}
                <a class="btn btn-primary" href="{{{editurl}}}">{{#str}}editsubmission, mod_checkpoint{{/str}}</a>
            {{/can_edit}}
        </div>

        {{#hastext}}
            <div class="mt-3">
                <h4 class="h6">{{#str}}submissiontext, mod_checkpoint{{/str}}</h4>
                <div>{{{submissiontext}}}</div>
            </div>
        {{/hastext}}

        {{#hasfiles}}
            <div class="mt-3">
                <h4 class="h6">{{#str}}evidence, mod_checkpoint{{/str}}</h4>
                <ul class="mb-0">
                    {{#files}}
                        <li><a href="{{{url}}}">{{name}}</a></li>
                    {{/files}}
                </ul>
            </div>
        {{/hasfiles}}

        {{#graded}}
            <div class="mt-3 border-top pt-3">
                <div><strong>{{#str}}grade, mod_checkpoint{{/str}}:</strong> {{grade}} / {{grademax}}</div>
                {{#hasfeedback}}
                    <div class="mt-2"><strong>{{#str}}feedback, mod_checkpoint{{/str}}:</strong></div>
                    <div>{{{feedback}}}</div>
                {{/hasfeedback}}
            </div>
        {{/graded}}
    </div>
</div>
